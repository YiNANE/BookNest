# ---- BookNest server configuration (copy to .env and fill in) ----

# HTTP port
PORT=3000

# Session signing secret — change this in production
SESSION_SECRET=change-me-to-a-long-random-string

# Environment
NODE_ENV=development

# SQLite database file (relative to the project root)
DB_PATH=./data/booknest.db

# Upload directory for cover images (inside the app, served by the server)
UPLOAD_DIR=./uploads

# Digital material files live OUTSIDE the static root (never served directly)
FILES_DIR=./files
